{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "sample",
        "measured"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "type": "string"
        },
        "gpu": {
          "type": "string"
        },
        "torch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "python",
        "gpu",
        "torch"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "mhr_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "config_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "upstream_commit",
        "checkpoint_sha256",
        "mhr_sha256",
        "config_sha256"
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "input_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "mpjpe_mm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "input_sha256",
          "latency_ms",
          "mpjpe_mm"
        ]
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency_p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "latency_p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mpjpe_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "latency_p50_ms",
        "latency_p95_ms",
        "mpjpe_mm"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^meshes/[A-Za-z0-9_-]+\\.json$"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "kind",
    "status",
    "model",
    "dataset",
    "protocol",
    "environment",
    "provenance",
    "samples",
    "metrics",
    "notes",
    "artifacts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result v1.0"
}
